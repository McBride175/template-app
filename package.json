{
  "name": "yuohme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/accounting/*.test.mjs tests/auth/*.test.mjs tests/billing/*.test.mjs tests/privacy/*.test.mjs tests/xero/*.test.mjs tests/database/*.test.mjs tests/seo/*.test.mjs",
    "test:accounting-refresh:db": "RUN_SUPABASE_INTEGRATION=1 node --test tests/database/accounting-refresh.integration.test.mjs",
    "test:billing:db": "RUN_SUPABASE_INTEGRATION=1 node --test tests/database/billing-enforcement.integration.test.mjs",
    "test:xero-generation:db": "RUN_SUPABASE_INTEGRATION=1 node --test tests/database/xero-sync-generation.integration.test.mjs",
    "test:xero-generation-persistence:db": "RUN_SUPABASE_INTEGRATION=1 node --test tests/database/xero-generation-persistence.integration.test.mjs",
    "test:xero-generation-importer:db": "RUN_SUPABASE_INTEGRATION=1 node --test tests/database/xero-generation-importer.integration.test.mjs",
    "test:xero-readiness:db": "RUN_SUPABASE_INTEGRATION=1 node --test tests/database/xero-promotion-readiness.integration.test.mjs",
    "xero:generation:operator": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/xero-generation-operator.ts",
    "xero:generation:revalidate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/xero-generation-revalidate.ts",
    "measure:first-value": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/measure-first-value-latency.ts",
    "test:baseline": "node --test tests/database/baseline-contract.test.mjs",
    "security:sqlcheck": "bash scripts/security-sql-check.sh",
    "test:privacy": "node --test tests/privacy/*.test.mjs",
    "test:xero-concurrency": "node --test tests/xero/grant-refresh-concurrency.test.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck:storybook": "tsc --noEmit --project .storybook/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:auth": "tsx scripts/e2e-auth.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.74.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "cldr-core": "48.2.0",
    "clsx": "^2.1.1",
    "lossless-json": "4.3.1",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^4.8.0",
    "server-only": "^0.0.1",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@next/env": "16.1.1",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "26.1.0",
    "storybook": "10.6.1",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vite": "8.3.4"
  }
}
